# 仅参考真实配置。生产请用密码管理器生成
# Web 面板（FR-6 / 非功能·安全性）
WEB_USERNAME=admin
WEB_PASSWORD=change-me-strong
WEB_TOKEN=change-me-long-random-string

# 数据库与日志
DATA_DIR=/app/data
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_JSON=true

# 调度作业的 cron 表达式与运行参数**不在这里配**（2026-10-24 起）：
# - cron 默认值是代码常量（app/services/job_registry.py 的 DEFAULT_CRON）
# - 运行参数默认值见 app/services/runtime_params.py 的 PARAM_SPECS
# - 用户在「设置 → 调度」页改的值落进 DB，**跨重启保持**
#
# 常见调整方式：直接改代码里的默认值，或在页面上改（无需重启）。
#
# AI 读码（hdsky 的 6 位图形验证码）
# 三项**全空 = 未配置** → hdsky 降级为「需人工签到」，作业不变红。
# 走 OpenAI 兼容协议（POST {AI_API_BASE}/chat/completions），
# 模型必须是**视觉**模型（能吃 image_url 内容块）。
# 例：AI_API_BASE=https://llmapi.banstack.top/v1
#     AI_MODEL=minimax-cn/MiniMax-M3
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# 资源限制：常驻内存 < 150MB，CPU < 3%（非功能 §6）
