# 仅参考真实配置。生产请用密码管理器生成
# Web 面板（FR-6 / 非功能·安全性）
WEB_USERNAME=admin
WEB_PASSWORD=change-me-strong
WEB_TOKEN=change-me-long-random-string

# 数据库与日志
DATA_DIR=/app/data
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_JSON=true

# 调度作业 cron 表达式（5 字段：分 时 日 月 星期）
# 统一站点拉取所有站点（API/HTML），结果写入 torrent_index 表
FETCH_ALL_SITES_CRON=*/10 * * * *
# 免费种自动推送（默认每 30 分钟）
PUSH_FREE_CRON=*/30 * * * *
# 限时种剩余窗口低于此小时数则不推（默认 6）
PUSH_MIN_REMAINING_HOURS=6
# 免费窗口巡检（5/15/25/... 错峰 fetch 与 push）
MONITOR_FREE_WINDOW_CRON=5,15,25,35,45,55 * * * *
# 距 free_end_at 不足此分钟数且未完成 → 自动暂停下载器任务
MONITOR_PRE_PAUSE_MINUTES=10

# 资源限制：常驻内存 < 150MB，CPU < 3%（非功能 §6）
