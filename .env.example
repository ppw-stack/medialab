# 仅参考真实配置。生产请用密码管理器生成，并部署密钥备份（FR-7.1）
# 启动会 fail-fast，缺失时打印：python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# Web 面板（FR-6 / 非功能·安全性）
WEB_USERNAME=admin
WEB_PASSWORD=change-me-strong
WEB_TOKEN=change-me-long-random-string

# 数据库与日志
DATA_DIR=/app/data
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_JSON=true
TZ=Asia/Shanghai

# 调度作业 cron 表达式（5 字段：分 时 日 月 星期）
# 统一 RSS 拉取所有站点，结果写入 torrent_index 表
FETCH_ALL_SITES_CRON=*/10 * * * *

# 资源限制：常驻内存 < 150MB，CPU < 3%（非功能 §6）