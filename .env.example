# 仅参考真实配置。生产请用密码管理器生成
#
# **两个业务域共用同一个 .env**——变量名零冲突。

# ================================================================ 基础
# Web 面板（单管理员）
# ⚠️ 下面的 change-me* 是**占位符**：启动时会被拒绝，必须替换成随机值。
WEB_USERNAME=admin
WEB_PASSWORD=change-me-strong
# session HMAC 密钥（**必填**，prod 至少 32 字符）—— openssl rand -hex 32
WEB_TOKEN=change-me-long-random-string

# 数据库与日志
DATA_DIR=/app/data
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_JSON=true

# 数据库文件路径（默认 data_dir/medialab.db）
# DB_PATH=/app/data/medialab.db
# SQLite 日志模式：DELETE（commit 后立即落盘，重启不丢 WAL 缓冲）
DB_JOURNAL_MODE=DELETE

# 调度器总开关
SCHEDULER_ENABLED=true

# ================================================================ 辅种域
#
# 调度作业的 cron 表达式与运行参数**不在这里配**（2026-10-24 起）：
# - cron 默认值是代码常量（app/services/job_registry.py 的 DEFAULT_CRON）
# - 运行参数默认值见 app/services/runtime_params.py 的 PARAM_SPECS
# - 用户在「设置 → 调度」页改的值落进 DB，**跨重启保持**
#
# 常见调整方式：直接改代码里的默认值，或在页面上改（无需重启）。
#
# 辅种孤儿文件扫描的目录（容器内路径 = 下载器里的 downloadDir 同路径）。
# 逗号分隔多个目录，每个目录独立扫描。路径必须与 downloadDir 完全一致。
# 留空 = 不做孤儿扫描（该功能降级，前端显示「未启用」）。
CROSS_SEED_SCAN_DIRS=

# AI 读码（hdsky 的 6 位图形验证码）
# 三项**全空 = 未配置** → hdsky 降级为「需人工签到」，作业不变红。
# 走 OpenAI 兼容协议（POST {AI_API_BASE}/chat/completions），
# 模型必须是**视觉**模型（能吃 image_url 内容块）。
# 例：AI_API_BASE=https://llmapi.banstack.top/v1
#     AI_MODEL=minimax-cn/MiniMax-M3
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# ================================================================ 媒体库域
#
# 中转服务（302 直链）
# 【必填】写进 STRM 的对外地址，必须是**播放器（Emby / Infuse）能访问到
# 的地址**——不是容器内地址（否则 STRM 里的 URL 对客户端不可达）。
PUBLIC_BASE_URL=
# 【必填】中转 URL 的 HMAC 签名密钥 —— openssl rand -hex 32
# 换了它，所有已生成的 STRM 立即失效（需重扫）。
SIGNING_SECRET=
# 【必填】光鸭凭据加密密钥 —— openssl rand -hex 32
# 换了它，已存的登录态解不开（需重新扫码）。
CREDENTIAL_ENCRYPTION_SECRET=

# 直链缓存
LINK_CACHE_L1_SIZE=1000
LINK_CACHE_TTL_MARGIN_SEC=300
LINK_CACHE_DEFAULT_TTL_SEC=600

# 无 UA 客户端（Infuse 等）的兜底 UA（缓存按 UA 分桶）
DEFAULT_USER_AGENT=

# 请求限速（秒）—— 0 = 不限速
# 光鸭官方限频：列目录 5 次/秒、换直链 2 次/秒
GUANGYA_RATE_LIMIT_INTERVAL_SEC=0.2
# 迁移时轮询光鸭离线任务状态的间隔（秒）
MIGRATION_POLL_INTERVAL_SEC=5.0

# ================================================================ 离线下载
#
# 「本地文件 → 光鸭」走**光鸭服务端拉取**（而非本机上行）——流量方向是
# 下行，绕开本机上行带宽限制（见 docs/upload-bandwidth.md）。
#
# **临时用**：传完把端口映射关掉即可，不必改这里的值。
#
# 离线下载的 HMAC 密钥（**留空 = 不启用**，不挂载文件服务）
# —— openssl rand -hex 32
OFFLINE_HMAC_SECRET=
# 暴露给光鸭的公网入口（不带尾斜杠）。
# 必须是**光鸭能访问到**的地址（如 http://your-host:8092）。
OFFLINE_PUBLIC_BASE=
# 要暴露的本地目录（容器内绝对路径）。留空 = 不启用。
OFFLINE_FILES_ROOT=

# WebDAV（只读暴露媒体库目录）
# 生产默认关——暴露前要先在「WebDAV」页建好 DAV 账号。
DAV_ENABLED=false
DAV_MOUNT_PATH=/dav
# 按 IP 的请求数限流（每分钟）。DAV 与面板**分开计**。
DAV_RATE_LIMIT_PER_MIN=1200
# 按用户的请求数限流（每分钟）
DAV_USER_RATE_LIMIT_PER_MIN=2400
# 认证失败多少次后锁定（按 IP 与按用户名各自独立）
DAV_MAX_FAILURES=5
# 锁定时长（秒）
DAV_LOCK_SEC=900
# WebDAV 认证结果缓存时长（秒）—— PBKDF2 600k 迭代约 42ms，
# 不缓存的话 Infuse 扫一次库要几十秒
DAV_AUTH_CACHE_SEC=60
# 审计日志留存天数。0 = 永久保留。
DAV_AUDIT_RETENTION_DAYS=90
# wsgidav 的 WSGI 线程池大小（DAV 请求在它里面跑）
DAV_WSGI_WORKERS=8

# 上传任务（本地目录 → 光鸭盘）
# 【重要】默认 true：生产路径常常是 CIFS / FUSE 挂载（Unraid 的
# /mnt/user 是 shfs），**都不支持 inotify**——用 inotify 会一个事件都
# 收不到，看起来像任务坏了。纯本地 ext4 / APFS 可设为 false。
UPLOAD_WATCH_POLLING=true
UPLOAD_WATCH_POLL_MS=1000
UPLOAD_WATCH_DEBOUNCE_MS=1500
# 文件「写完」判定：两次采样之间 size/mtime 不变才算稳态（秒）
UPLOAD_STABLE_CHECK_SEC=1.5
# 单个上传任务的队列上限（待传文件数）
UPLOAD_QUEUE_MAXSIZE=1000

# 优雅停机（等在途作业 / 扫描任务收尾）
SHUTDOWN_GRACE_SECONDS=60
